{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/vision.html",
      "destination": "/vision",
      "permanent": true
    },
    {
      "source": "/webrf/index.html",
      "destination": "/webrf",
      "permanent": true
    },
    {
      "source": "/wms-cost/",
      "destination": "/wms-cost",
      "permanent": true
    },
    {
      "source": "/wms-cost.html",
      "destination": "/wms-cost",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/vision",
      "destination": "/vision.html"
    },
    {
      "source": "/webrf",
      "destination": "/webrf/index.html"
    },
    {
      "source": "/wms-cost",
      "destination": "/wms-cost.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "buildCommand": "node preview-only.cjs",
  "outputDirectory": ".",
  "framework": null
}
