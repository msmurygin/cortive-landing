{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/vision.html",
      "destination": "/vision",
      "permanent": true
    },
    {
      "source": "/webrf/index.html",
      "destination": "/webrf",
      "permanent": true
    },
    {
      "source": "/wms-cost/",
      "destination": "/wms-cost",
      "permanent": true
    },
    {
      "source": "/wms-cost.html",
      "destination": "/wms-cost",
      "permanent": true
    },
    {
      "source": "/screens.html",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/screens",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/screens/",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/product.html",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/product/",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/tools/wms-readiness-assessment/",
      "destination": "/tools/wms-readiness-assessment",
      "permanent": true
    },
    {
      "source": "/tools/wms-readiness-assessment/index.html",
      "destination": "/tools/wms-readiness-assessment",
      "permanent": true
    },
    {
      "source": "/integrations.html",
      "destination": "/integrations",
      "permanent": true
    },
    {
      "source": "/integrations/",
      "destination": "/integrations",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/pricing/",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/bg/",
      "destination": "/bg",
      "permanent": true
    },
    {
      "source": "/bg/index.html",
      "destination": "/bg",
      "permanent": true
    },
    {
      "source": "/ro/",
      "destination": "/ro",
      "permanent": true
    },
    {
      "source": "/ro/index.html",
      "destination": "/ro",
      "permanent": true
    },
    {
      "source": "/sr/",
      "destination": "/sr",
      "permanent": true
    },
    {
      "source": "/sr/index.html",
      "destination": "/sr",
      "permanent": true
    },
    {
      "source": "/el/",
      "destination": "/el",
      "permanent": true
    },
    {
      "source": "/el/index.html",
      "destination": "/el",
      "permanent": true
    },
    {
      "source": "/solutions/legacy-hardware/",
      "destination": "/solutions/legacy-hardware",
      "permanent": true
    },
    {
      "source": "/solutions/legacy-hardware/index.html",
      "destination": "/solutions/legacy-hardware",
      "permanent": true
    },
    {
      "source": "/tools/wms-cost-calculator",
      "destination": "/wms-cost",
      "permanent": true
    },
    {
      "source": "/tools/wms-cost-calculator/",
      "destination": "/wms-cost",
      "permanent": true
    },
    {
      "source": "/tools/wms-cost-calculator.html",
      "destination": "/wms-cost",
      "permanent": true
    },
    {
      "source": "/tools/wms-cost-calculator/index.html",
      "destination": "/wms-cost",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/vision",
      "destination": "/vision.html"
    },
    {
      "source": "/webrf",
      "destination": "/webrf/index.html"
    },
    {
      "source": "/wms-cost",
      "destination": "/wms-cost.html"
    },
    {
      "source": "/product",
      "destination": "/product.html"
    },
    {
      "source": "/tools/wms-readiness-assessment",
      "destination": "/tools/wms-readiness-assessment/index.html"
    },
    {
      "source": "/integrations",
      "destination": "/integrations.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/bg",
      "destination": "/bg/index.html"
    },
    {
      "source": "/ro",
      "destination": "/ro/index.html"
    },
    {
      "source": "/sr",
      "destination": "/sr/index.html"
    },
    {
      "source": "/el",
      "destination": "/el/index.html"
    },
    {
      "source": "/solutions/legacy-hardware",
      "destination": "/solutions/legacy-hardware/index.html"
    }
  ],
  "headers": [
    {
      "source": "/webrf/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/webrf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/balkan-pages.cjs && node scripts/generate-sitemap.cjs"
}
