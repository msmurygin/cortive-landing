{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/vision.html",
      "destination": "/vision",
      "permanent": true
    },
    {
      "source": "/webrf/index.html",
      "destination": "/webrf",
      "permanent": true
    },
    {
      "source": "/wms-cost/",
      "destination": "/wms-cost",
      "permanent": true
    },
    {
      "source": "/wms-cost.html",
      "destination": "/wms-cost",
      "permanent": true
    },
    {
      "source": "/tools/wms-readiness-assessment/",
      "destination": "/tools/wms-readiness-assessment",
      "permanent": true
    },
    {
      "source": "/tools/wms-readiness-assessment.html",
      "destination": "/tools/wms-readiness-assessment",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/vision",
      "destination": "/vision.html"
    },
    {
      "source": "/webrf",
      "destination": "/webrf/index.html"
    },
    {
      "source": "/wms-cost",
      "destination": "/wms-cost.html"
    },
    {
      "source": "/tools/wms-readiness-assessment",
      "destination": "/tools/wms-readiness-assessment.html"
    }
  ],
  "headers": [
    {
      "source": "/webrf/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/webrf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/tools/wms-readiness-assessment",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "buildCommand": "node preview-only.cjs",
  "outputDirectory": ".",
  "framework": null
}
