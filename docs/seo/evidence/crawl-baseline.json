      "html": {
        "title": "Quark Vision — A long-term concept for warehouse software",
        "meta": {
          "": "",
          "viewport": "width=device-width,initial-scale=1",
          "description": "The long-term Quark vision: metadata-driven warehouse software, reversible configuration and human oversight. A concept, not a statement of current availability.",
          "og:type": "website",
          "og:url": "https://quark.build/vision",
          "og:title": "Quark Vision — Long-term concept",
          "og:description": "A long-term concept for metadata-driven warehouse software. Current availability is described on the product page.",
          "og:site_name": "Quark",
          "twitter:card": "summary_large_image",
          "twitter:title": "Quark Vision — Long-term concept",
          "twitter:description": "A long-term concept for metadata-driven warehouse software. Current availability is described on the product page.",
          "robots": "index,follow"
        },
        "canonical": [
          "https://quark.build/vision"
        ],
        "headings": [
          {
            "level": 1,
            "text": "Our long-term vision: The warehouse that configures itself."
          },
          {
            "level": 2,
            "text": "Traditional WMSis stuck in 2010."
          },
          {
            "level": 3,
            "text": "You are running it on spreadsheets, or on something you inherited."
          },
          {
            "level": 3,
            "text": "We would rather say so than waste your quarter."
          },
          {
            "level": 2,
            "text": "Describe your warehouse.Log in tomorrow."
          },
          {
            "level": 3,
            "text": "Tell the AI about your operation."
          },
          {
            "level": 3,
            "text": "Review the draft in the Studio."
          },
          {
            "level": 3,
            "text": "Operators log in. The system is live."
          },
          {
            "level": 2,
            "text": "Metadata‑GovernableArchitecture."
          },
          {
            "level": 2,
            "text": "Five layers.One contract."
          },
          {
            "level": 2,
            "text": "Two readers.One economic shift."
          },
          {
            "level": 3,
            "text": "Your business is not threatened.It is transformed."
          },
          {
            "level": 3,
            "text": "Pharma. 3PL. Food. Electronics."
          },
          {
            "level": 2,
            "text": "A platform of particles.Each one does one thing well."
          },
          {
            "level": 3,
            "text": "Quark"
          },
          {
            "level": 3,
            "text": "Phonon"
          },
          {
            "level": 3,
            "text": "Gluon"
          },
          {
            "level": 3,
            "text": "Boson"
          },
          {
            "level": 3,
            "text": "Lepton"
          },
          {
            "level": 3,
            "text": "Hadron"
          },
          {
            "level": 3,
            "text": "Axion"
          },
          {
            "level": 3,
            "text": "Photon"
          },
          {
            "level": 3,
            "text": "Neutrino"
          },
          {
            "level": 3,
            "text": "Fermion"
          },
          {
            "level": 3,
            "text": "Higgs"
          },
          {
            "level": 3,
            "text": "Meson"
          },
          {
            "level": 2,
            "text": "One person.A short list of things that already run."
          },
          {
            "level": 3,
            "text": "What you can see today."
          },
          {
            "level": 3,
            "text": "What we are not pretending."
          },
          {
            "level": 2,
            "text": "Start with the current product."
          }
        ],
